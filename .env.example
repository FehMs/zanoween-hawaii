# Credenciais somente no servidor. Copie para .env.local; nunca publique os valores.
APP_URL=https://zanoween-hawaii.vercel.app
CHECKOUT_ENABLED=false
MERCADO_PAGO_ENVIRONMENT=production
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# Opcional para expansoes futuras; o Pix atual e criado apenas pelo servidor.
MERCADO_PAGO_PUBLIC_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Alternativa legada; deixe vazia quando usar SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Remetente de um dominio verificado no Resend.
RESEND_FROM=
CHECKOUT_HASH_SECRET=
CHECKIN_TOKEN=
CRON_SECRET=
# Apenas para o servidor local.
PORT=3001
