{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [{"source":"/admin","destination":"/admin.html"},{"source":"/admin/","destination":"/admin.html"}],
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "includeFiles": "server/assets/**",
      "maxDuration": 60
    }
  },
  "crons": [{ "path": "/api/payment-jobs", "schedule": "0 12 * * *" }]
}
